# AirNow (free key from api.airnow.gov)
AIRNOW_API_KEY=your_airnow_api_key_here
AIRNOW_MOCK=true   # set to false in production

# Supabase (project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # server-only, never expose

# Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+13125550000

# Upstash Redis (console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Chicago Open Data Portal (optional, raises rate limit)
CHICAGO_ODP_APP_TOKEN=your_socrata_app_token

# App
NEXT_PUBLIC_APP_URL=https://windyandclear.org
CRON_SECRET=generate_a_random_32_char_string_here
