{
  "crons": [
    {
      "path": "/api/cron/sms-alerts",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/air-quality",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=3300, stale-while-revalidate=300" }
      ]
    }
  ]
}
